# Copy to .env to run the app locally against the Azure resources you deployed.
# Fill in the values from `azd env get-values` after `azd up`.

# Azure Cosmos DB for NoSQL
COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
COSMOS_DATABASE=retail

# Azure Managed Redis (OSS clustering policy)
REDIS_HOST=<amr-name>.<region>.redis.azure.net
REDIS_PORT=10000

# Behavior
CATEGORY_TTL_SECONDS=120
PRODUCT_TTL_SECONDS=300
NOT_FOUND_TTL_SECONDS=30
CART_TTL_SECONDS=1800
SOFT_DELETE_TTL_SECONDS=3600
AUTO_SEED=false                            # the deployed app already seeded the shared account
