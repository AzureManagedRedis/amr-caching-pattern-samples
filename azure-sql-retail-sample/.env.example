# Copy to .env to run the app locally against the Azure resources you deployed.
# Fill in the values from `azd env get-values` after `azd up`.

# Azure SQL Database
SQL_SERVER=<server-name>.database.windows.net
SQL_DATABASE=retail

# Azure Managed Redis (OSS clustering policy)
REDIS_HOST=<amr-name>.<region>.redis.azure.net
REDIS_PORT=10000
REDIS_USER_OBJECT_ID=<your-object-id>      # your Microsoft Entra object (principal) ID

# Behavior
PRODUCT_TTL_SECONDS=300
NOT_FOUND_TTL_SECONDS=30
SYNC_INTERVAL_SECONDS=30
FLUSH_INTERVAL_SECONDS=15
RUN_JOBS=false                             # the deployed app already runs the scheduled jobs
AUTO_SEED=false                            # the deployed app already seeded the shared database

# Set by Bicep for seeding only; not needed locally. On first start, the deployed app's
# seed step (seed.py) uses them to create database users for the function app identity
# and for you, the developer who ran `azd up`.
# FUNC_IDENTITY_NAME=<function-identity-name>
# FUNC_IDENTITY_CLIENT_ID=<function-identity-client-id>
# DEVELOPER_OBJECT_ID=<your-object-id>
