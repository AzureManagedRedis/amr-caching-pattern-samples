# Copy to .env to run the app locally against the Azure resources you deployed.
# Fill in the values from `azd env get-values` after `azd up`.

# Azure Database for PostgreSQL flexible server
POSTGRES_HOST=<server-name>.postgres.database.azure.com
POSTGRES_DB=retail
POSTGRES_USER=<your-user-principal-name>   # your Entra sign-in (UPN)
POSTGRES_PORT=5432

# Azure Managed Redis (OSS clustering policy)
REDIS_HOST=<amr-name>.<region>.redis.azure.net
REDIS_PORT=10000
REDIS_USERNAME=<your-object-id>            # your Entra object (principal) ID

# Behavior
CACHE_TTL_SECONDS=300
ORDERS_STREAM=orders:events
ORDERS_GROUP=fulfillment
RUN_WORKER=true
AUTO_SEED=false                            # the deployed app already seeded the shared database
